# the dial-up callers' DNS server: dnsmasq in their VRF, on SERVER_ADDR,
# with the service overrides of /etc/dmodem-login/dns.d
[Unit]
Description=dmodem-login dial-up DNS
Requires=dmodem-login-dialup.service
After=dmodem-login-dialup.service

[Service]
ExecStart=/usr/sbin/ip vrf exec dialup /usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dmodem-login/dnsmasq.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
