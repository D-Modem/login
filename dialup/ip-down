#!/bin/sh
# /etc/ppp/ip-down.d/dmodem-login-dialup: the link's name off the firewall's
# list, for the next link of that name
CONF=/etc/dmodem-login/dialup.conf
[ -r "$CONF" ] || exit 0
# shellcheck source=/dev/null
. "$CONF"
[ "${PPP_LOCAL:-}" = "$SERVER_ADDR" ] || exit 0
exec /usr/local/sbin/dmodem-login-dialup detach "$PPP_IFACE"
