# /etc/systemd/system/modemmenu-ldapd.service - modemmenu's LDAP provider
# alone ([ldapd]), for programs that use the same users and passwords,
# where modemmenu runs from app_dmodem a call at a time and not as -serve
# (which answers it too)
[Unit]
Description=modemmenu: the LDAP provider
After=network.target

[Service]
ExecStart=/usr/local/bin/modemmenu -config /etc/asterisk/modemmenu.conf -ldapd
RuntimeDirectory=modemmenu
RuntimeDirectoryMode=0755
Restart=on-failure
# root for auth = system (PAM's pam_unix); otherwise a user of its own
# that can read modemmenu.conf, the users file and the TLS key
User=root
# ports 389 and 636 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
