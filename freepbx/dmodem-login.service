# /etc/systemd/system/dmodem-login.service - dmodem-login -serve for FreePBX's
# D-Modem "menu" profile (a server on the unix socket
# /run/dmodem-login/dmodem-login.sock, call details first)
[Unit]
Description=dmodem-login: login and menu for dial-up callers
After=network.target
# FreePBX 17 starts Asterisk from freepbx.service; older ones from
# asterisk.service.  The socket is there before either takes calls
Before=freepbx.service asterisk.service

[Service]
ExecStart=/usr/local/bin/dmodem-login -config /etc/dmodem-login/dmodem-login.conf -serve
RuntimeDirectory=dmodem-login
RuntimeDirectoryMode=0755
# time limits and last callers: /var/lib/dmodem-login
StateDirectory=dmodem-login
Restart=on-failure
# root, for pppd (its noauth and the routes it adds)
User=root

[Install]
WantedBy=multi-user.target
